# SECRET_KEY — generate with: openssl rand -hex 32
SECRET_KEY=
# POSTGRES_PASSWORD — generate with: openssl rand -hex 16
POSTGRES_PASSWORD=
# Public HTTPS domain for GlitchTip (Caddy on the app stack terminates TLS)
GLITCHTIP_DOMAIN=https://ingest.hedgeyour.fun
# From-address shown in GlitchTip emails
DEFAULT_FROM_EMAIL=ops@hedgeyour.fun
# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=
# Telegram chat id where alerts are delivered
TELEGRAM_CHAT_ID=
# Secret path segment publishing tg-bridge on ingest.hedgeyour.fun/hook-<this> for GlitchTip's
# alert webhook (its SSRF guard refuses docker-internal URLs). Generate: openssl rand -hex 16
TG_BRIDGE_HOOK=
