# Production env template for the Docker Compose stack.
# Copy to /opt/hedgefun/.env on the VPS, fill real values, chmod 600. NOT committed.

# --- Postgres (compose `db` service) ---
POSTGRES_USER=hedgefun
POSTGRES_PASSWORD=CHANGE_ME_STRONG
POSTGRES_DB=hedgefun

# --- App runtime ---
# host=db resolves on the internal compose network; password must match POSTGRES_PASSWORD.
DATABASE_URL=postgresql://hedgefun:CHANGE_ME_STRONG@db:5432/hedgefun?schema=public
PRIVY_APP_SECRET=CHANGE_ME_ROTATED_SECRET
# Secret for hashing referral-click IP/UA (cross-browser attribution fallback). Generate with
# `openssl rand -hex 32`. If UNSET, the IP/UA fallback is disabled gracefully (cookie path still
# works); set it in prod to catch the in-app-browser → system-browser case. See src/lib/refclick.ts.
REFERRAL_HASH_SECRET=CHANGE_ME_RANDOM_HEX_32
# Needed at BUILD (inlined into client bundle) AND runtime — compose passes it as a build arg.
NEXT_PUBLIC_PRIVY_APP_ID=CHANGE_ME_PRIVY_APP_ID
NODE_ENV=production

# NEXT_PUBLIC_SHARE_BASE_URL — optional, defaults to https://app.hedgeyour.fun (src/lib/share.ts).
#   Override only for the Android build to aim invite links at a Play Store URL (deferred deep link).
# POLYMARKET_API_BASE — optional, code defaults to https://gamma-api.polymarket.com
# DEV_USER_EMAIL — intentionally UNSET in production (gates dev bypasses in src/lib/dev.ts)

# --- TxOdds TxLINE (football / World Cup) ---
# Powers the live ticker + World Cup deck/hub. Free WC tier (0 TxL). TXODDS_API_TOKEN comes from the
# one-time on-chain subscribe()+activate bootstrap (see docs/txline-football.md). Read by Next AND the
# poller. If TXODDS_API_TOKEN is unset, the ticker + football markets degrade to empty (no error).
TXODDS_API_BASE=https://txline.txodds.com
# ^ devnet: https://txline-dev.txodds.com (SL1, 60s-delayed). Mainnet host = SL12 real-time.
TXODDS_API_TOKEN=CHANGE_ME_TXLINE_API_TOKEN
TXODDS_WC_COMPETITION_ID=72
