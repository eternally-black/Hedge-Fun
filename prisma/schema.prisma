// HedgeFun — Prisma schema (Postgres)
// Money in integer cents. Price in basis points (0..10000). utcDay = 'YYYY-MM-DD' UTC string.
// Ledger stores RAW points; x2 multiplier is derived at read time (one strategy, one place).
// Idempotency enforced by DB unique constraints, never app logic.

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
  // "native" keeps local dev working (Windows/WSL); the Debian target is the
  // engine the Docker runtime image (node:24-bookworm-slim, glibc) needs.
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

// ============================================================ ENUMS

enum AuthProvider {
  EMAIL
  TWITTER
}

enum BetSide {
  YES
  NO
}

enum MarketStatus {
  OPEN // tradable, deck-eligible
  CLOSED // trading halted, not yet UMA-final (dispute window)
  RESOLVED // outcome final
  CANCELED // voided/invalid -> bets pushed
}

enum MarketOutcome {
  YES
  NO
  INVALID
}

enum MarketSource {
  POLYMARKET // cached from Polymarket Gamma; polymarketId = conditionId; settled via fetchResolution
  // DEAD as a live source: the TxOdds TxLINE World Cup integration was removed 2026-08-03 (see
  // docs/archive/). Kept because dropping an enum value means recreating the type in Postgres for no
  // gain, the historical rows below still reference it, and four DB test suites seed it as their
  // "no CLOB book" fixture. Nothing writes new TXODDS rows.
  TXODDS
}

enum SettlementStatus {
  PENDING
  SETTLED
  VOID
}

enum BetResult {
  PENDING
  WIN
  LOSS
  PUSH
}

enum BetSource {
  DECK // the daily swipe deck: earns points (capped) + capped shards
  FEED // the post-cap feed: NO points, shards UNCAPPED
  HEDGE // an accepted hedge suggestion (wallet/life-event): VARIABLE stake, NO points, NO daily cap; settles via the SAME poller as a standard bet (D6/D8)
  WALLET // a stock lot adopted from the user's own wallet (xStocks that were there before we booked anything): entered at the price of the day it was first seen
}

// Hedge suggestion kind (spec §2/§5). S1_* ship in this packet; S2/FALLBACK are reserved for the
// life-event packet (kept in the enum so the telemetry table doesn't need a later migration).
enum HedgeSuggestionKind {
  S1_MAJOR // direct hedge on a major holding (SOL / wrapped BTC / wrapped ETH)
  S1_PROXY // long-tail SPL aggregate -> SOL-short proxy (basis risk)
  S2 // reserved: life-event hedge
  FALLBACK // reserved: discovery fallback (never presented as a hedge)
  S1_STOCK // wallet exposure -> a tokenized-stock leg (xStocks; Stocklana)
  S3_STOCK // life situation (flights/fuel/rent...) -> a tokenized-stock card
  SPOTTED // a live 24h move fired a rule's trigger (no user input needed)
}

// Lifecycle of a real (on-chain) stock buy. PENDING from the moment the swap tx is built; the client
// stamps `sig` right after Phantom sends; CONFIRMED only after the server READ the landed tx and
// matched it against this row; EXPIRED when lastValidBlockHeight passed with no matching tx on chain.
enum StockAttemptStatus {
  PENDING
  CONFIRMED
  EXPIRED
  FAILED
}

// A real on-chain attempt is a BUY (USDC -> xStock) or a SELL (xStock -> USDC) — one row type, one
// sweep, one confirm, because the receipt semantics are identical: the chain is checked against what
// the server itself built.
enum StockAttemptKind {
  BUY
  SELL
}

// The parsed direction of a strike market = which side (YES / outcome index 0) benefits from an
// UP move. "Bitcoin above 62,600" / "reach"/"hit" => UP (YES wins on a rise); "dip to"/"below" =>
// DOWN (YES wins on a fall). Hedging a LONG holding picks the opposite side of an UP market.
enum HedgeMarketDirection {
  UP
  DOWN
}

// Telemetry lifecycle for a suggestion (advisor consensus: "without this we learn nothing").
enum HedgeEventType {
  IMPRESSION
  ACCEPT
  DISMISS
}

enum PointsType {
  SWIPE // RAW 1/swipe, capped 10/day — the ONLY type x2 multiplies
  LOGIN // daily GM bonus (config constant), never multiplied
  REFERRAL // referral rewards, never multiplied
  STREAK_X2 // reserved: materialized x2 delta (Mode B). UNUSED at launch.
  TOPUP_SPEND // NEGATIVE-amount rows: points spent on a cash top-up (dormant). Never multiplied.
}

enum StreakState {
  ACTIVE
  BURNED_RECOVERABLE
  LOST
}

enum StreakEventType {
  QUALIFIED
  BURNED
  RECOVERED
  LOST
}

enum ReferralEventType {
  SIGNUP
  QUALIFIED
  INVITEE_BONUS
  INVITER_ACCRUAL
}

// ------------------------------------------------------------ real-money enums (plan §2.2)

enum BetMode {
  PAPER
  REAL
}

enum OrderDir {
  ENTRY // BUY into a position
  EXIT // SELL out of it
}

enum OrderAttemptState {
  ISSUED // intent created, server-approved params returned for signing
  SIGNED // signed order received and validated against the intent
  SUBMITTING // claimed for posting; external call may be in flight (crash fence)
  POSTED // exchange accepted; awaiting fill resolution
  FILLED // fully matched
  PARTIAL // matched below requested size, FAK cancelled the remainder
  KILLED // zero fill — no position, the market slot frees for a retry
  FAILED // rejected or errored before/at post
}

enum WalletOpKind {
  DEPLOY
  APPROVALS
  WRAP
  REDEEM // burn resolved outcome tokens -> pUSD (S7)
  WITHDRAW // collateral-return: positions back into pUSD inside the wallet (S7, owner Q2)
  BRIDGE_OUT // the money-out leg: pUSD transfer to a single-purpose bridge address (S10)
}

enum WalletWorkflowState {
  PENDING_SIGNATURE
  SUBMITTING
  DONE
  FAILED
}

enum RelayerTxStatus {
  SUBMITTING
  CONFIRMED
  FAILED
}

enum FundingState {
  AWAITING // declared, nothing on chain yet
  DETECTED // USDC.e delta seen — wrap needed
  FUNDED // pUSD delta seen — spendable collateral
}

// ============================================================ USER

model User {
  id                    String       @id @default(cuid())
  privyId               String       @unique
  authProvider          AuthProvider
  email                 String?      @unique
  twitterHandle         String?      @unique
  embeddedWalletAddress String?      @unique
  referralCode          String       @unique // short code (src/lib/refcode.ts), set at create time
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt
  lastSeenAt            DateTime?
  // Device fingerprint captured at signup (HMAC-SHA256 of IP / UA+lang, see refclick.ts). Powers the
  // referral self/multi-account device guard: two accounts created on the same device get equal
  // hashes -> a referral between them is rejected. Nullable — pre-guard users and signups without
  // REFERRAL_HASH_SECRET stay null, and the guard skips a user whose signup device is unknown.
  signupIpHash          Bytes?
  signupUaHash          Bytes?
  // Real-money (plan §2.2/§2.3): the user's Polymarket Deposit Wallet (deterministic from the
  // embedded signer; persisted because reading beats re-deriving) and the explicit opt-in moment.
  // The env allowlist is the outer gate; this is the durable per-user consent.
  depositWalletAddress  String?      @unique
  realConsentAt         DateTime?
  // WHICH text they accepted. A timestamp alone records that someone clicked, not what they were
  // shown; once the terms change, an old acceptance stops meaning the same thing. Nullable because
  // rows that consented before versioning existed genuinely do not know — treated as "needs to
  // re-accept" rather than silently backfilled to the current version.
  realConsentVersion    String?
  // Which economy the user is CURRENTLY looking at. Server-side rather than client state because
  // the deck, the balance and the history all have to answer per-mode: a client-only flag would let
  // a stale tab render paper positions under a real-money header. Turning it on requires the same
  // two gates every money route re-checks (allowlist + consent), so this column can never be the
  // thing that authorises spending — it only decides what is shown.
  realMode              Boolean      @default(false)
  // How much a single real swipe stakes, in cents. Per-user because it is the one real-money number
  // a person has to be able to set for themselves — the paper stake is a game rule, this is their
  // money. Server-side for the same reason realMode is: /api/real/intent must not take the amount
  // to spend from the client. Default and floor are both $1 (REAL_DEFAULT_STAKE_CENTS), which is
  // what Polymarket's own ticket accepts as a market buy at any price.
  realStakeCents        Int          @default(100)
  // Tokenized-stock eligibility (Stocklana): the moment the user accepted the xStocks terms and
  // self-declared as not a US person / not in a restricted jurisdiction, and WHICH version of that
  // text. /api/stocks/real/tx refuses to build a swap without the current version — the same
  // "consent is a versioned record, not a click" reasoning as realConsentVersion above.
  stockConsentAt        DateTime?
  stockConsentVersion   Int?

  bets                  Bet[]
  pointsLedger          PointsLedger[]
  virtualBalance        VirtualBalance?
  collectibleBalance    CollectibleBalance?
  shardGrants           ShardGrant[]
  dailyCounters         DailyCounter[]
  loginMarks            LoginMark[]
  streak                Streak?
  streakEvents          StreakEvent[]
  referralsMade         Referral[]             @relation("Inviter")
  referralReceived      Referral?              @relation("Invitee")
  hedgeWallets          HedgeWallet[]
  hedgeSuggestionEvents HedgeSuggestionEvent[]
  orderAttempts         OrderAttempt[]
  walletWorkflows       WalletWorkflow[]
  fundingAttempts       FundingAttempt[]
  relayerTxs            RelayerTx[]
  clobCredential        ClobCredential?
  stockPositions        StockPosition[]
  stockPasses           StockPass[]
  stockAttempts         StockBuyAttempt[]
  lifeSituations        LifeSituation[]

  @@index([createdAt])
  @@map("users")
}

// ============================================================ MARKET (cached from Polymarket)

model Market {
  id           String       @id @default(cuid())
  // External market id + unique upsert key. POLYMARKET: the Gamma conditionId. Historical TXODDS
  // rows carry a synthetic "txline:{fixtureId}:{kind}" here (see the enum note above).
  polymarketId String       @unique
  source       MarketSource @default(POLYMARKET)
  question     String
  category     String? // usually null on Gamma; derived/optional
  imageUrl     String?

  // Verifiable settlement. Was set by the TxOdds integration (scores anchored to a Solana Merkle
  // root) and drove a "⛓ Solana-anchored" badge. Nothing writes these anymore and no client reads
  // them; kept so the 7 historical settled rows stay truthful and a future verifiable source needs
  // no migration. /api/results still emits the keys as false/null — see src/lib/api-types.ts.
  verifiedOnChain Boolean @default(false)
  onchainRef      String? // Solscan-able link/ref to the on-chain anchor (TxLINE program / daily root)

  // Real side labels for display. Binaries aren't always Yes/No — they're teams, players,
  // Over/Under, candidates. Internal model stays binary (YES = side A / index 0, NO = side B
  // / index 1); these carry the names the card shows. Default "Yes"/"No" for legacy rows.
  outcomeYesLabel String @default("Yes")
  outcomeNoLabel  String @default("No")

  // Snapshot pricing in basis points (0..10000). Per-bet price locked on Bet.
  // yesPriceBp/noPriceBp are the Gamma MID (reference/display fallback) — NOT touched by D10.
  yesPriceBp Int?
  noPriceBp  Int?

  // Depth-aware executable pricing (D10 Slice A). yesTokenId/noTokenId are the CLOB token ids
  // (Gamma clobTokenIds[0/1]). The four eff/max numbers come from walking the live book: per side,
  // the VWAP to BUY STAKE_CENTS of that token and the stake the book absorbs within the eligibility
  // slippage cap (src/lib/depth.ts), anchored to bookTsAt = when the book behind them was read.
  // NULL for bookless-source rows (no CLOB book — their stored odds stay authoritative) and for
  // POLYMARKET rows whose book read failed. Additive only — nothing above is renamed or dropped.
  yesTokenId       String?
  noTokenId        String?
  yesEffPriceBp    Int?
  noEffPriceBp     Int?
  yesMaxStakeCents Int?
  noMaxStakeCents  Int?
  bookTsAt         DateTime?

  // Real-money fee cache (plan §2.6): per-market platform taker fee, fee = rate × (p(1−p))^exp
  // per share (proven against a real fill 2026-08-13 — predicted == charged to the micro-cent).
  // Source: fetchMarketInfo via the credential-free public client, refreshed at INTENT time on a
  // 24h TTL (fees.ts). rateBp = rate×10⁴, expMilli = exponent×10³ — integers per house rule.
  // negRisk from the same call: neg-risk markets are EXCLUDED from real mode (third approval unset).
  feeRateBp    Int?
  feeExpMilli  Int?
  feeUpdatedAt DateTime?
  negRisk      Boolean?

  // Which sport / which game ("Soccer", "MLB", "CS2"), named at ingest from Gamma's tags — the only
  // place a club-vs-club market states its discipline ("PFK Mash'al Mubarek vs. FC Andijon" does
  // not). Stored because serve time has no tags. NULL on non-match markets, and on match markets we
  // could not name — those are never served (deck-mix.isUnnamedMatch).
  league             String?

  startsAt           DateTime? // from startDate (sports/esports kickoff); null for crypto/Yes-No. Gates "not started yet" in the deck.
  resolutionDeadline DateTime // from endDate; powers <=24h blitz filter
  status             MarketStatus   @default(OPEN)
  resolvedOutcome    MarketOutcome?
  resolvedAt         DateTime?

  lastPolledAt DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  bets          Bet[]
  meta          MarketMeta?
  hedgeEvents   HedgeSuggestionEvent[]
  orderAttempts OrderAttempt[]

  @@index([status, resolutionDeadline]) // deck assembly
  @@index([status, resolvedAt]) // settlement scan
  @@index([source, status, resolutionDeadline]) // per-source scans (the ?sport= filter it was added for is gone)
  @@index([resolutionDeadline]) // prune-markets anti-join
  @@map("markets")
}

// ============================================================ BET (swipe)

model Bet {
  id       String @id @default(cuid())
  userId   String
  user     User   @relation(fields: [userId], references: [id])
  marketId String
  market   Market @relation(fields: [marketId], references: [id])

  side          BetSide
  stakeCents    Int // 10000 == $100.00 (config STAKE_CENTS)
  lockedPriceBp Int // price of the BOUGHT side in bp at swipe time (yes-bet -> yes price, no-bet -> no price)
  utcDay        String    @db.VarChar(10)
  earnedPoint   Boolean   @default(false) // over-cap swipes = false
  // Where this bet came from. DECK = the daily swipe deck (points + capped shards).
  // FEED = the post-cap feed (no points; shards UNCAPPED — see awardShard bypassCap).
  // Default DECK so every pre-feed row backfills correctly (non-breaking migration).
  source        BetSource @default(DECK)

  // Hedge provenance (D6/D8): the DETERMINISTIC suggestion id this bet was accepted from
  // (src/lib/hedge/id.ts — hash of address+marketId+kind+sizing). Null for deck/feed bets. Powers
  // idempotent accept (re-accepting a suggestion returns this bet, never a duplicate) + telemetry.
  hedgeSuggestionId String?

  settlementStatus SettlementStatus @default(PENDING)
  result           BetResult        @default(PENDING)
  payoutCents      Int?
  pnlCents         Int?
  resolvedYes      Boolean?

  // PAPER = virtual-dollar game (everything above). REAL = a Polymarket position aggregate: the row
  // is created ON FILL (never at swipe), stakeCents keeps the swiped all-in intent, and the fields
  // below carry actuals from Fill rows in exchange atomic units (micro-USD / micro-shares, BigInt —
  // aggregate cents discard fill precision). Paper settlement/holds/points paths MUST filter on
  // mode; real P&L derives from these, never from stakeCents/lockedPriceBp.
  mode              BetMode @default(PAPER)
  filledSharesMicro BigInt?
  spendMicro        BigInt?
  feeMicro          BigInt?
  vwapBp            Int?
  closedSharesMicro BigInt?
  proceedsMicro     BigInt?
  closeFeeMicro     BigInt?
  realizedPnlMicro  BigInt?

  // Which LOT the fill fields above describe. A fully-closed REAL position is re-enterable, and the
  // re-entry reuses this row with the counters reset (orders.ts bookEntryFills), so "filled/closed"
  // stop describing the attempt that produced them. Every OrderAttempt records the lotSeq it booked
  // into; a late fee true-up compares the two and refuses to restate a lot it no longer belongs to.
  lotSeq            Int       @default(0)

  createdAt DateTime  @default(now())
  settledAt DateTime?
  seenAt    DateTime? // null = result not yet revealed to the user (inbox/reveal). Drives unread count.

  shardGrant    ShardGrant?
  pointsLedger  PointsLedger? // back-relation of the SWIPE point credit's FK (PointsLedger.betId)
  orderAttempts OrderAttempt[]

  // One bet per market per user PER MODE (C1): a card is swiped once. Kills the
  // "farm the daily cap against a single market" exploit; the mode split keeps a
  // paper bet from blocking a real position on the same market (and vice versa).
  @@unique([userId, marketId, mode])
  @@index([settlementStatus])
  @@index([marketId, settlementStatus])
  @@index([userId, utcDay])
  @@index([userId, settlementStatus, seenAt]) // unread-results scan (/api/me unreadResults, /api/results/seen)
  @@index([userId, hedgeSuggestionId]) // idempotent hedge-accept lookup (re-accept -> existing bet)
  @@index([userId, createdAt]) // /api/history sorts by createdAt after filtering on userId
  @@index([userId, settledAt]) // /api/results sorts by settledAt after filtering on userId
  @@map("bets")
}

// ============================================================ POINTS LEDGER (append-only, RAW)

model PointsLedger {
  id     String     @id @default(cuid())
  userId String
  user   User       @relation(fields: [userId], references: [id])
  type   PointsType
  amount Int // RAW points, never pre-multiplied
  utcDay String     @db.VarChar(10)

  // SWIPE provenance + idempotency (1 pt/bet). The unique alone was NOT enough: with no FK a credit
  // could name a bet that never existed (or another user's), and nothing in the DB objected —
  // ShardGrant.betId has had a real FK since 0_init. ON DELETE SET NULL (the Prisma default for an
  // optional relation) keeps awarded points and drops only the link. The FK is added NOT VALID in
  // 20260815210000_ledger_integrity: the table has live rows, so legacy orphans are left for ops to
  // clear + VALIDATE, while every new write is already constrained.
  betId      String?  @unique
  bet        Bet?     @relation(fields: [betId], references: [id])
  referralId String? // REFERRAL provenance
  metadata   Json?
  createdAt  DateTime @default(now())

  // Idempotency lives on the SOURCE of each point type, not here, because REFERRAL
  // legitimately writes many rows/day:
  //   SWIPE     -> unique betId above (1 pt/bet)
  //   LOGIN     -> LoginMark unique [userId,utcDay] gates the write (login.ts)
  //   REFERRAL  -> ReferralEvent.sourcePointsLedgerId / inviteeBonusPaidAt (referral.ts)
  //   STREAK_X2 -> unused at launch (derived multiplier mode)
  @@index([userId, type]) // breakdown + leaderboard ranking
  @@index([userId, utcDay])
  @@map("points_ledger")
}

// ============================================================ VIRTUAL BALANCE

model VirtualBalance {
  userId        String   @id
  user          User     @relation(fields: [userId], references: [id])
  balanceCents  Int      @default(20000) // start $200.00 (= START_BALANCE_CENTS). Total = Cash + Locked.
  lockedCents   Int      @default(0) // Σ stakes on still-PENDING bets ("hold"). Cash = balance − locked.
  freeTopupUsed Boolean  @default(false) // lifetime free top-up consumed
  topupCount    Int      @default(0) // count of paid (artifact/points) top-ups — audit only
  updatedAt     DateTime @updatedAt

  @@map("virtual_balances")
}

// ============================================================ COLLECTIBLES

model CollectibleBalance {
  userId       String   @id
  user         User     @relation(fields: [userId], references: [id])
  shards       Int      @default(0) // remainder after artifact conversion (0..19)
  artifacts    Int      @default(0)
  // Card-skins cosmetics: ids from the in-code catalog (src/lib/skins.ts). Everyone owns "classic"
  // for free; premium skins are bought with artifacts (unlock pushes the id here + equips it).
  ownedSkins   String[] @default(["classic"])
  equippedSkin String   @default("classic")
  updatedAt    DateTime @updatedAt

  @@map("collectible_balances")
}

model ShardGrant {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  betId     String   @unique // 1 winning bet -> at most 1 shard, ever
  bet       Bet      @relation(fields: [betId], references: [id])
  utcDay    String   @db.VarChar(10)
  counted   Boolean  @default(true) // false = over daily cap, recorded but not added
  createdAt DateTime @default(now())

  @@index([userId, utcDay])
  @@map("shard_grants")
}

// ============================================================ DAILY COUNTER

model DailyCounter {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  utcDay      String   @db.VarChar(10)
  swipeCount  Int      @default(0)
  shardCount  Int      @default(0)
  skipCount   Int      @default(0) // skips today; first is free, each next costs 1 shard
  loginMarked Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, utcDay])
  @@map("daily_counters")
}

// ============================================================ LOGIN MARK

model LoginMark {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  utcDay      String   @db.VarChar(10)
  bonusAmount Int // raw login points (config constant)
  createdAt   DateTime @default(now())

  @@unique([userId, utcDay])
  @@map("login_marks")
}

// ============================================================ STREAK

model Streak {
  userId           String      @id
  user             User        @relation(fields: [userId], references: [id])
  currentLevel     Int         @default(0)
  state            StreakState @default(ACTIVE)
  lastQualifiedDay String?     @db.VarChar(10)
  burnedAt         DateTime?
  recoverableUntil DateTime? // burnedAt + RECOVERY_WINDOW_DAYS
  recoveredCount   Int         @default(0)
  updatedAt        DateTime    @updatedAt

  @@index([state])
  @@map("streaks")
}

model StreakEvent {
  id           String          @id @default(cuid())
  userId       String
  user         User            @relation(fields: [userId], references: [id])
  type         StreakEventType
  utcDay       String          @db.VarChar(10)
  levelBefore  Int
  levelAfter   Int
  artifactUsed Boolean         @default(false)
  createdAt    DateTime        @default(now())

  @@unique([userId, utcDay, type])
  @@index([userId, createdAt])
  @@map("streak_events")
}

// ============================================================ REFERRAL

model Referral {
  id                 String          @id @default(cuid())
  inviterId          String
  inviter            User            @relation("Inviter", fields: [inviterId], references: [id])
  inviteeId          String          @unique
  invitee            User            @relation("Invitee", fields: [inviteeId], references: [id])
  createdAt          DateTime        @default(now())
  qualifiedAt        DateTime?
  inviteeBonusPaidAt DateTime?
  events             ReferralEvent[]

  @@index([inviterId])
  @@map("referrals")
}

model ReferralEvent {
  id                   String            @id @default(cuid())
  referralId           String
  referral             Referral          @relation(fields: [referralId], references: [id])
  type                 ReferralEventType
  sourcePointsLedgerId String?           @unique // 1 accrual per source ledger row
  sourceAmount         Int?
  rewardAmount         Int?
  metadata             Json?
  createdAt            DateTime          @default(now())

  @@index([referralId, type])
  @@map("referral_events")
}

// A click on a referral link (/r/<code> or /?ref=<code>), logged BEFORE signup so attribution
// survives the device losing the cookie (in-app browser -> system browser is the common mobile
// case). ip/ua are HMAC-SHA256 hashes, never plaintext — defense in depth against a DB dump,
// not a privacy claim (see lib/refclick.ts). Looked up by (ipHash, uaHash) within 7 days when a
// fresh signup has no hf_ref cookie. No FK to User — the clicker isn't a user yet.
model ReferralClick {
  id        String   @id @default(cuid())
  code      String // the inviter's referralCode that was clicked
  ipHash    Bytes // HMAC-SHA256(ip)
  uaHash    Bytes // HMAC-SHA256(user-agent\naccept-language)
  createdAt DateTime @default(now())

  // The cross-browser attribution lookup: WHERE ipHash=? AND uaHash=? AND createdAt > now()-7d.
  @@index([ipHash, uaHash, createdAt])
  @@map("referral_clicks")
}

// ============================================================ LEADERBOARD (deferred UI)

model LeaderboardSnapshot {
  id          String   @id @default(cuid())
  utcDay      String   @db.VarChar(10)
  userId      String
  rank        Int
  totalPoints Int // effective (multiplier-applied) total
  createdAt   DateTime @default(now())

  @@unique([utcDay, userId])
  @@index([utcDay, rank])
  @@map("leaderboard_snapshots")
}

// Single-row lease for the settlement poller (one runner at a time). One row, id 1; the poller
// tick runs only while it holds the lease; the lease outlives a tick by one interval so a crashed
// holder frees it by itself (expiresAt passes and the next runner takes over).
model PollerLease {
  id        Int      @id @default(1)
  holder    String
  expiresAt DateTime
  updatedAt DateTime @updatedAt

  @@map("poller_lease")
}

// ============================================================ HEDGE ENGINE (phase 2, workstream A)

// A read-only Solana address the user linked for wallet-hedge suggestions (S1). We never ask for
// keys. Multiple addresses per user are allowed later; unique per (user, address) for now.
model HedgeWallet {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id])
  address    String // base58 Solana address (validated at link time)
  createdAt  DateTime  @default(now())
  // Set when the address is one of the user's Privy-LINKED Solana wallets (the wallet signed Privy's
  // challenge). A pasted address only proves the user typed it once; only a verified one may be
  // offered as a withdraw destination (/api/real/withdraw GET `connected.solana`).
  verifiedAt DateTime?

  @@unique([userId, address])
  @@index([address])
  @@map("hedge_wallets")
}

// Cached exposure + Birdeye PnL for one address, keyed by ADDRESS (shared across users who link the
// same wallet). exposure/avgCost are DERIVED JSON blobs (re-buildable from Helius+Jupiter+Birdeye),
// so no relational modelling — the snapshot is a TTL cache, not a source of truth. Birdeye wallet
// APIs are beta-capped (5 rps / 75 rpm, D4) so pnlFetchedAt gates a SEPARATE, slower refresh: the
// exposure half can refresh without paying a Birdeye call every time.
model WalletSnapshot {
  address            String    @id // base58 address is the cache key
  exposure           Json // ExposureResult: per-asset balances × prices × notional (see src/lib/hedge/exposure.ts)
  avgCost            Json? // { <mint>: avgBuyCostCents } from Birdeye; null when Birdeye degraded (graceful)
  totalNotionalCents Int       @default(0)
  fetchedAt          DateTime  @default(now()) // exposure TTL anchor (WALLET_SNAPSHOT_TTL_MS)
  pnlFetchedAt       DateTime? // Birdeye avg-cost TTL anchor (separate, rate-capped)

  @@map("wallet_snapshots")
}

// Enrichment layer over the Market cache for hedge matching. One row per cached Market. Populated by
// scripts/refresh-hedge-index.ts from Gamma tag discovery + deterministic slug/question parsing.
// parseOk = strike + date + direction ALL machine-parsed -> the market qualifies for S1 matching.
model MarketMeta {
  id       String @id @default(cuid())
  marketId String @unique
  market   Market @relation(fields: [marketId], references: [id])

  asset          String? // "BTC" | "ETH" | "SOL" (the underlying major), null if not a major
  tagSlug        String? // gamma tag slug the market was discovered under (bitcoin/ethereum/solana)
  eventSlug      String? // gamma event slug (context)
  eventTicker    String? // gamma event ticker (context)
  series         String? // gamma series title (context)
  strikeCents    Int? // parsed strike in integer cents ($62,600 -> 6_260_000)
  direction      HedgeMarketDirection? // UP (above/reach/hit) | DOWN (dip/below/under)
  parsedDeadline DateTime? // canonical resolution instant (Gamma endDate)
  liquidityCents Int? // ranking only, SATURATES at the INT4 ceiling (~$21.47M) — see rankCents()
  volumeCents    Int? // ranking only, SATURATES at the INT4 ceiling (~$21.47M) — see rankCents()
  parseOk        Boolean               @default(false) // strike + date + direction all parsed -> S1-eligible

  // S2 (life-event hedge) enrichment. A NAMED sports/esports (later: entertainment) market whose
  // side labels are the entities a user might support. Populated by scripts/refresh-hedge-index.ts
  // from Gamma discovery + deck-mix league classification. s2Eligible gates the pickers/matcher;
  // the two side labels live on Market (outcomeYesLabel/outcomeNoLabel), startsAt on Market too.
  s2Eligible  Boolean @default(false) // NAMED, contested, upcoming -> usable for S2 pickers + matching
  leagueSlug  String? // slugified league/competition (e.g. "nba", "cs2", "soccer") for grouping
  leagueLabel String? // display league/competition (e.g. "NBA", "CS2") from deck-mix gameOf; null if unknown
  sportKind   String? // "sports" | "esports" | "entertainment" (from deck-mix categoryOf)

  updatedAt DateTime @updatedAt

  @@index([asset, parseOk])
  @@index([s2Eligible])
  @@map("market_meta")
}

// Append-only telemetry: one row per (user, suggestion, event). Deduped per event type so re-sending
// an impression / accept / dismiss is idempotent (upsert on the unique key). betId set on ACCEPT.
model HedgeSuggestionEvent {
  id                 String              @id @default(cuid())
  suggestionId       String // deterministic id (src/lib/hedge/id.ts) — stable across re-derivation
  userId             String
  user               User                @relation(fields: [userId], references: [id])
  address            String // the hedged wallet address
  // Nullable since the stock kinds (S1_STOCK / S3_STOCK / SPOTTED): a tokenized-stock card has no
  // Market behind it — stockSymbol carries the instrument instead, and positionId the lot on ACCEPT.
  marketId           String?
  market             Market?             @relation(fields: [marketId], references: [id])
  stockSymbol        String? // "DALx" — set on stock-kind events, null on market kinds
  positionId         String? // set on a stock ACCEPT (the StockPosition created)
  kind               HedgeSuggestionKind
  side               BetSide // the side that hedges the holding (down-benefit)
  proposedStakeCents Int // the SIZED stake we OFFERED (before the per-user Cash clamp)
  // The stake actually LOCKED on ACCEPT — equals proposedStakeCents unless it was clamped down to
  // available Cash (D8). Null on IMPRESSION/DISMISS (no bet). Funnel analytics must read THIS for the
  // real accepted notional; proposedStakeCents overstates it whenever a clamp fired (F16).
  actualStakeCents   Int?
  event              HedgeEventType
  betId              String? // set on ACCEPT (the Bet created)
  createdAt          DateTime            @default(now())

  @@unique([userId, suggestionId, event]) // idempotent telemetry (one impression/accept/dismiss per user per suggestion)
  @@index([suggestionId])
  @@index([userId, createdAt])
  @@map("hedge_suggestion_events")
}

// ============================================================ REAL MONEY (plan §2.2)
// Append-only execution ledger under the Bet aggregate. Durable intent BEFORE every external call;
// idempotency by unique constraints, never app logic (house rule above).

// One order attempt = one two-phase intent (ISSUED with server-approved params → client signs →
// SUBMITTING fence → posted → resolved from fills). A retry NEVER reuses a non-terminal attempt.
model OrderAttempt {
  id       String  @id @default(cuid())
  userId   String
  user     User    @relation(fields: [userId], references: [id])
  marketId String
  market   Market  @relation(fields: [marketId], references: [id])
  betId    String? // set when fills materialize/update the position row
  bet      Bet?    @relation(fields: [betId], references: [id], onDelete: Restrict) // never silently detach the ledger from its position

  dir            OrderDir
  side           BetSide
  tokenId        String
  idempotencyKey String   @unique // server-issued at intent time; the client echoes it back
  approvedParams Json // the exact params the client must sign; submit validates the signed order against THIS
  allInCapMicro  BigInt // the user's all-in debit cap (maxSpend), micro-USD
  maxPriceBp     Int // marginal-ask bound, tick-rounded (up for BUY, down for SELL)

  state           OrderAttemptState @default(ISSUED)
  signedOrderHash String?           @unique // replay guard
  // The signed order VERBATIM, persisted at CAS time — before the post that may or may not reach the
  // exchange. An attempt that crashes between postOrder and the POSTED write is invisible to every
  // reconcile scan (they filter on a non-null externalOrderId) and wedges the market slot forever;
  // without the payload nobody can even work out which exchange order it became. Recovery is still a
  // human with this row, not an automatic path — the SDK exports no order-hash helper to derive the
  // id from it — but "a human can" beats "nobody can".
  signedOrder     Json?
  // The Bet lot this attempt's fills landed in; null on attempts that never booked. See Bet.lotSeq.
  lotSeq          Int?
  // Set once the exchange's terminal trade records have been booked and the fee trued up; the
  // stuck-attempt sweep skips such rows.
  reconciledAt    DateTime?
  externalOrderId String?           @unique
  postResponse    Json? // authoritative receipt, persisted verbatim at post time
  error           String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  fills     Fill[]

  // Single in-flight per (user, market) is a PARTIAL unique index over non-terminal states —
  // Prisma can't express it, so it lives as raw SQL in the migration:
  //   CREATE UNIQUE INDEX "order_attempts_one_inflight" ON "order_attempts"("userId","marketId")
  //   WHERE "state" IN ('ISSUED','SIGNED','SUBMITTING','POSTED');
  @@index([userId, marketId, state])
  @@index([state, updatedAt]) // poller: reconcile stuck SUBMITTING/POSTED
  @@map("order_attempts")
}

// One exchange fill. Source of truth for real position math — exchange atomic units only.
model Fill {
  id             String       @id @default(cuid())
  attemptId      String
  attempt        OrderAttempt @relation(fields: [attemptId], references: [id])
  externalFillId String       @unique
  sharesMicro    BigInt
  amountMicro    BigInt // spend (ENTRY) or proceeds (EXIT)
  feeMicro       BigInt
  priceBp        Int
  ts             DateTime
  createdAt      DateTime     @default(now())

  @@index([attemptId])
  @@map("fills")
}

// Durable state machine for relayer-driven gasless workflows (approvals, wrap): the generator is
// rebuilt from `inputs` per request, replayed, and each regenerated yield must byte-match
// pendingRequestHash. ONE row per (user, kind) IS the single-flight guard — the row is reused as a
// state machine across runs (wrap runs once per deposit); submission history lives in RelayerTx.
// Ambiguous submissions converge from CHAIN state (allowance/pUSD present), never blind resubmit.
model WalletWorkflow {
  id     String              @id @default(cuid())
  userId String
  user   User                @relation(fields: [userId], references: [id])
  kind   WalletOpKind
  state  WalletWorkflowState @default(PENDING_SIGNATURE)

  // v2 (S4 rework): the generator lives IN MEMORY per run (the SDK generator is non-deterministic
  // — fresh nonce+deadline per build — so cross-request rebuild-and-replay cannot work). runId
  // keys the live session and the per-run RelayerTx budget row; the DB row is the single-flight
  // slot + submit fence + observability.
  runId              String?
  stepIndex          Int     @default(0)
  inputs             Json // immutable inputs of the CURRENT run (observability + convergence params)
  answers            Json    @default("[]") // ordered accepted answers [{requestHash, signature}] — audit transcript
  pendingRequest     Json? // the yielded signature request awaiting the device
  pendingRequestHash String?
  // Relayer transactionId (NOT a chain hash). UNIQUE for the same reason as RelayerTx.txHash below,
  // and it is free here: freshRun() resets this row's txHash to NULL before every run, so a re-run
  // rewrites its OWN row and can never collide with itself. A collision across two rows would mean one
  // relayer submission is bound to two state machines — the exact ambiguity convergence must never be
  // asked to resolve. Postgres treats NULLs as distinct, so the (many) PENDING rows are unaffected.
  txHash             String? @unique
  error              String?

  expiresAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([userId, kind])
  @@map("wallet_workflows")
}

// One declared deposit. Balance-DELTA detection (never nonzero-balance — residuals lie): baselines
// snapshot at declare time; the poller's watcher advances state and NEVER gives up on user money
// (below-floor deposits park indefinitely and release on top-up — spec §6.2). Bridge /status is
// a hint at most, nowhere in this state machine.
model FundingAttempt {
  id     String       @id @default(cuid())
  userId String
  user   User         @relation(fields: [userId], references: [id])
  state  FundingState @default(AWAITING)

  baselineUsdceMicro BigInt @default(0)
  baselinePusdMicro  BigInt @default(0)
  latestUsdceMicro   BigInt @default(0)
  latestPusdMicro    BigInt @default(0)

  // Deposit ATTRIBUTION (§2.5): the Transfer-log cursor and what it has attributed so far. A
  // balance delta is an inference — an outflow masks it, any inflow fires it; a log names the tx.
  scanBlock     BigInt? // last finalized block scanned, inclusive; null = never scanned (delta fallback)
  inUsdceMicro  BigInt  @default(0)
  inPusdMicro   BigInt  @default(0)
  lastDepositTx String? // the transaction that carried the most recent attributed transfer

  declaredAt    DateTime  @default(now())
  lastCheckedAt DateTime?
  fundedAt      DateTime?
  alertedAt     DateTime? // parked-deposit ops alert sent once, never repeated

  // One ACTIVE attempt per user is a PARTIAL unique (raw SQL in the migration):
  //   CREATE UNIQUE INDEX "funding_attempts_one_active" ON "funding_attempts"("userId")
  //   WHERE "state" <> 'FUNDED';
  @@index([state, lastCheckedAt]) // watcher due-scan
  @@index([userId, declaredAt])
  @@map("funding_attempts")
}

// Every relayer OPERATION, written (SUBMITTING) BEFORE the external call — closes the
// crash-between-call-and-record window and is the 100/day Unverified-tier budget ledger.
// workflowKey is deterministic per operation so a retry storm collapses into one row per op;
// `attempts` increments per SUBMISSION, so retry spend stays countable (onboarding spend =
// rows, retry spend = Σ(attempts−1)) without giving retries their own rows.
model RelayerTx {
  id          String          @id @default(cuid())
  userId      String
  user        User            @relation(fields: [userId], references: [id])
  kind        WalletOpKind
  workflowKey String
  // The relayer transaction id, UNIQUE: workflowKey is the per-RUN id, so an idempotent relayer that
  // returns the SAME transactionId for a re-submitted request used to land one confirmed money
  // movement on two rows — and this table IS the 100/day budget ledger, which counts rows. Plain
  // @unique is the "non-null only" index the fix needs (Postgres NULLs are distinct), and stays
  // expressible in Prisma so the schema cannot drift from the database.
  txHash      String?         @unique
  status      RelayerTxStatus @default(SUBMITTING)
  attempts    Int             @default(1)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@unique([userId, kind, workflowKey])
  @@index([createdAt]) // daily budget counter + onboarding-vs-retry split
  @@map("relayer_txs")
}

// Derived L2 CLOB API creds (read/cancel only — NOT signing keys; D5 intact), encrypted at rest
// (AES-256-GCM). The encryption key lives in env, outside DB backups. Owner decision Q4 2026-08-13.
model ClobCredential {
  userId     String    @id
  user       User      @relation(fields: [userId], references: [id])
  ciphertext Bytes
  nonce      Bytes
  keyVersion Int       @default(1)
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@map("clob_credentials")
}

// ============================================================ STOCKS (xStocks on Solana — Stocklana)
// A tokenized stock is NOT a Market: it never resolves, it has no YES/NO, and its price is a spot
// price, so it gets its own tables instead of a synthetic Market row. Prices are integer cents per
// RAW token (Jupiter's usdPrice); quantities are raw base units (10^-decimals). The Token-2022
// ScaledUiAmount multiplier is DISPLAY only (uiMultiplierMicro) — raw × price is the accounting.
model StockAsset {
  id                String    @id @default(cuid())
  mint              String    @unique // Solana Token-2022 mint (the xStocks deployment address) — the upsert key
  symbol            String    @unique // "AAPLx"
  name              String // "Apple xStock"
  underlying        String // "AAPL"
  isin              String? // underlying security ISIN from the xStocks catalog — disambiguates the name for the blurb LLM
  blurb             String? // ≤ 10-word plain-English "what this is", LLM-generated ONCE (fillMissingBlurbs only writes nulls); null = not written yet, safe to overwrite by hand
  logoUrl           String?
  decimals          Int       @default(8) // base-unit exponent, from Jupiter price v3
  halted            Boolean   @default(false) // xStocks isTradingHalted
  tradingHours      String? // "TwentyFourFive" | "Regular" | "MarketHours" | null (2 assets carry no trading block)
  openNow           Boolean   @default(false)
  priceCents        Int? // Jupiter usdPrice per RAW token, integer cents; null = unpriced -> never served
  change24hBp       Int? // Jupiter priceChange24h (%) × 100
  liquidityCents    Int? // Jupiter liquidity, cents, saturated at INT4; null = no Solana pool (only ~60 of ~830 xStocks have one)
  mcapMillions      Int? // issuer's market cap (Jupiter stockData.mcap) in USD millions — ranks the deck's long tail
  uiMultiplierMicro Int? // scaledUiConfig.multiplier × 1e6 — DISPLAY only, never used in accounting
  deckEligible      Boolean   @default(false) // derived at refresh: !halted && priced && within the top pool (liquidity desc, then mcap desc)
  pricedAt          DateTime? // written ONLY on a successful Jupiter read (staleness gates depend on it)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  positions StockPosition[]
  passes    StockPass[]
  attempts  StockBuyAttempt[]

  @@index([deckEligible, liquidityCents])
  @@map("stock_assets")
}

// One row per BUY (a lot). PAPER: the stake is HELD on VirtualBalance.lockedCents exactly like a bet
// and released on sell. REAL: quantity/cost come from the confirmed on-chain transaction (txSig,
// attemptId), never from the client; a REAL lot is closed with closeReason "wallet" when the payer's
// live balance no longer backs it (sold/moved in Phantom).
model StockPosition {
  id                String     @id @default(cuid())
  userId            String
  user              User       @relation(fields: [userId], references: [id])
  assetId           String
  asset             StockAsset @relation(fields: [assetId], references: [id])
  mode              BetMode    @default(PAPER)
  source            BetSource  @default(DECK) // DECK | HEDGE | WALLET (FEED unused)
  requestId         String?    @unique // PAPER: client idempotency key (uuid) — a retried buy returns the same lot
  hedgeSuggestionId String? // set when a hedge suggestion was accepted into this lot
  qtyBase           BigInt // raw base units (10^-decimals)
  costCents         Int // PAPER: the held stake. REAL: USDC actually spent, rounded UP to the cent
  entryPriceCents   Int // cost / qty at entry (display: "bought at")
  txSig             String?    @unique // REAL: the confirmed Solana signature — the idempotency key
  sellTxSig         String?    @unique // REAL: the signature of the swap that SOLD this lot (unique = one sell per lot)
  payer             String? // REAL: the verified wallet that paid
  // REAL: the sponsor fronted this lot's token-account rent (copied from the attempt at confirm).
  // The sell that empties the account returns the rent to whoever paid it — sponsor or user.
  rentFromSponsor   Boolean    @default(false)
  attemptId         String?    @unique // REAL: the StockBuyAttempt this lot settled
  walletCheckedAt   DateTime? // REAL: last reconciliation against the payer's live token balance
  closedAt          DateTime?
  closeReason       String? // "sold" | "wallet" | "reset"
  proceedsCents     Int?
  pnlCents          Int?
  // Profit alerts: alertTierBp = the highest STOCK_ALERT_TIERS_BP tier this lot has crossed (0 =
  // none), raised only by one conditional updateMany — a tier fires once, a poller restart cannot
  // re-fire it. alertSeenAt resets to null on each new tier: the inbox's unread flag (= Bet.seenAt).
  alertTierBp       Int        @default(0)
  alertedAt         DateTime?
  alertSeenAt       DateTime?
  createdAt         DateTime   @default(now())

  @@unique([userId, hedgeSuggestionId]) // a hedge suggestion is accepted into at most one lot (NULLs are distinct)
  @@index([userId, closedAt])
  @@index([assetId])
  @@index([userId, alertSeenAt])
  @@map("stock_positions")
}

// Swipe-left: never deal this asset to this user again.
model StockPass {
  userId    String
  user      User       @relation(fields: [userId], references: [id])
  assetId   String
  asset     StockAsset @relation(fields: [assetId], references: [id])
  createdAt DateTime   @default(now())

  @@id([userId, assetId])
  @@map("stock_passes")
}

// A real buy the server BUILT (Jupiter swap tx for a verified wallet). The chain is the receipt, but
// this row is what the receipt is checked AGAINST: payer, mint, ExactIn amount, minimum output and the
// tx message hash all have to match the landed transaction, so an unrelated transfer can never be
// booked as a purchase. The poller sweeps PENDING rows: with a sig -> re-confirm; without one and past
// lastValidBlockHeight -> search the payer's recent signatures for a match, else EXPIRED.
model StockBuyAttempt {
  id                   String             @id @default(cuid())
  userId               String
  user                 User               @relation(fields: [userId], references: [id])
  assetId              String
  asset                StockAsset         @relation(fields: [assetId], references: [id])
  payer                String // the verified wallet the tx was built for
  kind                 StockAttemptKind   @default(BUY)
  positionId           String? // SELL: the open REAL lot this attempt sells in full
  sponsored            Boolean            @default(false) // the fee payer is OUR key (counts against the per-user daily cap)
  stakeCents           Int
  // BUY: ExactIn USDC (micro) in, minimum xStock (raw base units) out.
  // SELL: the column names are kept to avoid churn but the units flip — inAmountMicro holds the RAW
  // xStock amount sold (ExactIn) and minOutBase holds the MINIMUM USDC micro-amount out.
  inAmountMicro        BigInt
  minOutBase           BigInt
  msgHash              String // sha256 of the serialized swapTransaction bytes
  // The unsigned wire tx (base64) of a sponsored SELL. A retried sell RE-SERVES these bytes instead
  // of building a second transaction for the same lot: two live sells of one lot cannot both be
  // booked, and the second would quietly sell the wallet's OTHER tokens. Null on every other kind.
  unsignedTx           String?
  // BUY: the sponsor paid the rent of the token account this swap created (the wallet held none for
  // the mint). Only then does the SELL that empties it send the rent back to the sponsor — a user
  // who funded their own account keeps it. Provenance per ACCOUNT lives in SponsorFundedAccount;
  // this flag is kept for display (which lot's buy opened the account).
  rentFromSponsor      Boolean            @default(false)
  // SELL: this transaction closes the emptied token account, so the confirm knows a rent refund
  // happened and can retire the SponsorFundedAccount row.
  closeAta             Boolean            @default(false)
  lastValidBlockHeight BigInt
  hedgeSuggestionId    String?
  status               StockAttemptStatus @default(PENDING)
  sig                  String? // stamped by /real/sent as soon as the client has it
  createdAt            DateTime           @default(now())
  resolvedAt           DateTime?

  @@index([status, createdAt])
  @@index([userId, createdAt])
  @@map("stock_buy_attempts")
}

// WHO fronted a token ACCOUNT's rent — the question StockPosition.rentFromSponsor cannot answer,
// because rent belongs to the account and lots share one: buy A opens the account (on the sponsor),
// buy B lands in the same account (free), and the sell that finally empties it may well be B's. One
// row per sponsor-funded account, written when the swap that creates it is BUILT, confirmed when
// that swap lands, closed when a sell returns the rent. Deleted when the funding attempt dies
// (EXPIRED/FAILED): no swap, no account, no rent.
model SponsorFundedAccount {
  account     String    @id // the token account (ATA) the sponsor's rent opened
  userId      String
  payer       String // the wallet that owns the account
  mint        String
  attemptId   String? // the StockBuyAttempt whose build funded it
  fundedAt    DateTime  @default(now())
  confirmedAt DateTime? // the funding swap landed — the rent was really spent
  closedAt    DateTime? // a sell closed the account and the rent came back

  @@index([payer, mint])
  @@map("sponsor_funded_accounts")
}

// What the user told us about a life cost (category + amount + period + distance) — no raw text
// (nothing reads it, and it is PII). Persisted so a stock hedge card can be RE-DERIVED on accept
// without the query, and so spotted cards can be sized to the user. Last write per category wins.
model LifeSituation {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  category    String // StockCategory (src/lib/hedge/stock-rules.ts)
  amountCents Int?
  period      String? // "month" | "week" | "year" | "once"
  distanceKm  Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, category])
  @@map("life_situations")
}
