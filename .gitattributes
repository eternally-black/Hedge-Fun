# Keep LF on files that run in Linux containers — CRLF breaks shell scripts,
# Dockerfiles, and the Caddyfile when checked out on the VPS.
*.sh        text eol=lf
Dockerfile  text eol=lf
Caddyfile   text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.mjs       text eol=lf
# systemd units and the env TEMPLATES the installers copy into place: a CRLF here does not
# announce itself, it makes every value read out of .env end in a carriage return, so a token
# looks set but is malformed and a heartbeat URL becomes "".
*.service   text eol=lf
*.timer     text eol=lf
*.example   text eol=lf
