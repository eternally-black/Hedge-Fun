# A record app.hedgeyour.fun -> VPS must resolve, and ports 80+443 open,
# before first `up` — Caddy needs the ACME HTTP challenge for the cert.
# Caddy auto-provisions and renews the Let's Encrypt cert.
app.hedgeyour.fun {
	reverse_proxy app:3000
}

