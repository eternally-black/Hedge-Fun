# A record app.hedgeyour.fun -> VPS must resolve, and ports 80+443 open,
# before first `up` — Caddy needs the ACME HTTP challenge for the cert.
# Caddy auto-provisions and renews the Let's Encrypt cert.
app.hedgeyour.fun {
	reverse_proxy app:3000
}

# Self-hosted GlitchTip (separate compose project at /opt/glitchtip). Reached over the
# shared external docker network `glitchtip-shared`; the DNS A record for this subdomain
# must exist before Caddy can pass the ACME challenge (until then this block just logs
# cert retries — the app site above is unaffected).
glitchtip.hedgeyour.fun {
	reverse_proxy glitchtip-web:8000
}
