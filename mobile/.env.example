# Hedge Fun Android — public (EXPO_PUBLIC_*) config. Copy to .env and fill in.
# EXPO_PUBLIC_* vars are inlined into the JS bundle at build time — never put secrets here.

# Privy App ID — same app as the web client (NEXT_PUBLIC_PRIVY_APP_ID).
EXPO_PUBLIC_PRIVY_APP_ID=

# Privy mobile App Client ID — REQUIRED by the @privy-io/expo SDK (the web client doesn't use one).
# Privy dashboard → your app → Clients → add a mobile client. Also whitelist the OAuth redirect
# deep-link `hedgefun://` there for X (Twitter) login to return to the app.
EXPO_PUBLIC_PRIVY_CLIENT_ID=

# Backend API base (no trailing slash). All /api/* calls go here with `Authorization: Bearer`.
EXPO_PUBLIC_API_BASE=https://app.hedgeyour.fun

# Base URL for invite links (/r/<code> is appended). Once the Play Store listing exists this can
# become the store URL with &referrer=CODE (docs/share-and-android.md §4).
EXPO_PUBLIC_SHARE_BASE_URL=https://app.hedgeyour.fun
